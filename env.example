# Copy this file to .env and fill in your real values. Never commit .env.

# From @BotFather on Telegram after creating your bot
TELEGRAM_BOT_TOKEN=

# Your personal numeric Telegram user ID (the treasurer).
# Message @userinfobot on Telegram to get this.
TREASURER_CHAT_ID=

# Paste the ENTIRE contents of your Google service account JSON key file
# as one value here (see README for how to get this).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The ID from your Google Sheet's URL, e.g.:
# https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOp/edit
#                                        ^^^^^^^^^^^^^^^^^^ this part
GOOGLE_SHEET_ID=

# --- Branding ---
CLUB_NAME=Grove City College Outing Club
CLUB_ABBREVIATION=GCCOC

# --- Hosting mode ---
# polling: works anywhere, including your own computer (default)
# webhook: required for Railway/Render/most cloud hosts
RUN_MODE=polling
# Only needed when RUN_MODE=webhook. Your host's public HTTPS URL, no
# trailing slash, e.g. https://your-app.up.railway.app
WEBHOOK_URL=
PORT=8080

# Optional. Free from https://aistudio.google.com/apikey (no credit card,
# no expiration). If set, receipt reading uses Gemini AI for much better
# accuracy. If left blank, the bot automatically uses free local OCR instead.
GEMINI_API_KEY=
